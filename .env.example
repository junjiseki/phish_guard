APP_ENV=local
APP_DEBUG=true
APP_LOG_LEVEL=INFO

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_SIGNATURE_VERIFICATION_ENABLED=true

GEMINI_API_KEY=
